+
+static NSMutableArray *allDevices = nil;
+static int avdevice_refcount = 0;
+
+static void ensure_avdevice(void)
+{
+  if (avdevice_refcount == 0) {
+    avdevice_register_all();
+  }
+  avdevice_refcount++;
+}
 
